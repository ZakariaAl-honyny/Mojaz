{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Server=.;Database=DrivingLicenseIssuanceSystemDb;Trusted_Connection=True;TrustServerCertificate=True;MultipleActiveResultSets=true"
  },
  "AutoMigrate": true,
  "JwtSettings": {
    "SecretKey": "DrivingLicenseIssuanceSystem2025SecureJwtKeyForDevelopmentPurposesOnly!@#$%^&*",
    "Issuer": "DrivingLicenseIssuanceSystem",
    "Audience": "DrivingLicenseIssuanceSystemClients",
    "AccessTokenExpirationMinutes": 60,
    "RefreshTokenExpirationDays": 7
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:3000",
      "https://localhost:3000",
      "http://localhost:5013",
      "https://localhost:7127"
    ]
  },
  "SendGrid": {
    "ApiKey": "SG.REDACTED_API_KEY",
    "SenderEmail": "z.alhonyny123@auhd.edu.ye",
    "SenderName": "نظام إصدار رخص القيادة — DrivingLicenseIssuanceSystem Platform"
  },
  "Twilio": {
    "AccountSid": "AC.REDACTED_ACCOUNT_SID",
    "AuthToken": "REDACTED_AUTH_TOKEN",
    "FromNumber": "+967773497550"
  },
  "Firebase": {
    "ProjectId": "DrivingLicenseIssuanceSystem-659bb",
    "ServiceAccountPath": "firebase-service-account.json"
  },
  "RateLimiting": {
    "Enabled": true,
    "GlobalLimits": {
      "PermitLimit": 100,
      "Window": "00:01:00"
    },
    "Endpoints": {
      "Login": {
        "PermitLimit": 10,
        "Window": "00:01:00"
      },
      "Register": {
        "PermitLimit": 5,
        "Window": "00:01:00"
      },
      "OtpVerify": {
        "PermitLimit": 3,
        "Window": "00:01:00"
      }
    }
  },
  "Hangfire": {
    "DashboardUrl": "/hangfire",
    "WorkerCount": 5,
    "MaximumRetryAttempts": 3
  },
  "Serilog": {
    "MinimumLevel": "Information",
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "theme": "Serilog.Sinks.SystemConsole.Themes.AnsiConsoleTheme::Code, Serilog.Sinks.Console",
          "outputTemplate": "[{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz}] [{Level:u3}] {Message:lj}{NewLine}{Exception}"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/DrivingLicenseIssuanceSystem_.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 30,
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] {Message:lj}{NewLine}{Exception}"
        }
      }
    ],
    "Enrich": [
      "FromLogContext",
      "WithMachineName",
      "WithThreadId",
      "WithEnvironmentUserName"
    ]
  }
}